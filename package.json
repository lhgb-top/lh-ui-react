{
  "name": "@lh-ui/react",
  "type": "module",
  "version": "0.1.0",
  "description": "lh-ui React 18/19 UI 组件库（企业级国风水墨设计），基于 @lh-ui/share 框架无关共享层",
  "license": "Apache-2.0",
  "author": "lhgb <i@lhgb.top>",
  "keywords": [
    "lh-ui",
    "ui",
    "components",
    "component-library",
    "design-system",
    "theme",
    "react",
    "react18",
    "react19",
    "chinese-style",
    "ink-wash"
  ],
  "homepage": "https://www.lhgb.top/lhui/react/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhgb-top/lh-ui-react.git"
  },
  "bugs": {
    "url": "https://github.com/lhgb-top/lh-ui-react/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "module": "es/index.js",
  "unpkg": "dist/lh-ui-react.umd.js",
  "jsdelivr": "dist/lh-ui-react.umd.js",
  "types": "es/index.d.ts",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./lib": "./lib/index.js",
    "./es": "./es/index.js",
    "./dist": "./dist/lh-ui-react.umd.js",
    "./locale": {
      "types": "./es/locale/index.d.ts",
      "import": "./es/locale/index.js",
      "require": "./lib/locale/index.js"
    },
    "./theme": {
      "types": "./es/theme.d.ts",
      "import": "./es/theme.js",
      "require": "./lib/theme.js"
    },
    "./constants": {
      "types": "./es/constants.d.ts",
      "import": "./es/constants.js",
      "require": "./lib/constants.js"
    },
    "./hooks": {
      "types": "./es/hooks/index.d.ts",
      "import": "./es/hooks/index.js",
      "require": "./lib/hooks/index.js"
    },
    "./style/*": "./es/components/*/style/index.css",
    "./theme.css": "./dist/theme/index.css",
    "./theme-dark.css": "./dist/theme/index-dark.css"
  },
  "files": [
    "es",
    "lib",
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "build": "pnpm run build:esm && pnpm run build:cjs && pnpm run build:umd && pnpm run build:styles && pnpm run build:dts",
    "build:esm": "vite build --mode esm",
    "build:cjs": "vite build --mode cjs",
    "build:umd": "vite build --mode umd",
    "build:styles": "node scripts/build-styles.mjs",
    "build:dts": "tsc -p tsconfig.build.json",
    "verify:dts": "node scripts/verify-dts.mjs",
    "lint": "eslint src tests dev docs/demos docs/src scripts vite.config.ts vitest.config.ts tsconfig.json",
    "lint:fix": "eslint src tests dev docs/demos docs/src scripts vite.config.ts vitest.config.ts tsconfig.json --fix",
    "format": "prettier --write .prettierrc.json eslint.config.mjs .changeset/**/*.md",
    "format:check": "prettier --check .prettierrc.json eslint.config.mjs .changeset/**/*.md",
    "typecheck": "node scripts/gen-dev-tsconfig.mjs && tsc -p tsconfig.dev.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "changeset publish",
    "release:push": "node scripts/push-release.mjs",
    "prepublishOnly": "pnpm run build && pnpm run verify:dts",
    "docs:dev": "docusaurus start docs --port 5179",
    "docs:build": "docusaurus build docs --out-dir build",
    "docs:preview": "docusaurus serve docs --port 5179 --dir build"
  },
  "dependencies": {
    "@lh-ui/share": "^0.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "docusaurus-plugin-sass": "^0.2.7",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
